# 复制为 .env 再改（.env 不进 git、也不进镜像）。
# 希沃白板免密令牌，必填否则白板写不进来。生成：openssl rand -hex 24
# 白板浏览器地址栏：https://<域名>/?board_token=<这个值>
BOARD_TOKEN=
# JWT 签名密钥，必填。缺失时随启动随机生成，重启后所有人要重新登录。生成：openssl rand -hex 32
JWT_SECRET=
# 允许的前端源，逗号分隔；* 表示任意源（读接口本来就公开）
CORS_ORIGINS=*
# 容器内监听端口；改了要同步 docker-compose.yml 的端口映射
PORT=3100
# 容器内数据库路径，落在命名 volume classworks-data
DB_PATH=data/db.sqlite
