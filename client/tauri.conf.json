{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "作业看板",
  "version": "0.1.1",
  "identifier": "top.tianhw.classworks",
  "build": {
    "frontendDist": "./web"
  },
  "app": {
    "windows": [
      {
        "title": "作业看板",
        "url": "https://classworks.tianhw.top/?key=seewo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
